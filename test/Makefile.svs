# =============================================================================
# ZIRH - the SystemVerilog scenario suites (test/sv/)
#
#   make -C test -f Makefile.svs            # both suites, every scenario
#   make -C test -f Makefile.svs top        # chip-level mission slices
#   make -C test -f Makefile.svs boot       # boot-controller stories
#   make -C test -f Makefile.svs top SCENARIO=cmd_fuzz     # just one
#
# Pure iverilog -g2012, no cocotb: each bench drives and judges itself
# and exits nonzero through $fatal on the first failed check. The
# chip-level suite boots the full SoC per scenario and is the slow one
# (minutes); the boot suite runs in seconds.
# =============================================================================

SRC_DIR := $(CURDIR)/../src

TOP_SOURCES = zirh_tmr_lib.v \
           serv/serv_aligner.v serv/serv_alu.v serv/serv_bufreg.v \
           serv/serv_bufreg2.v serv/serv_compdec.v serv/serv_csr.v \
           serv/serv_ctrl.v serv/serv_decode.v serv/serv_immdec.v \
           serv/serv_mem_if.v serv/serv_rf_if.v serv/serv_rf_ram.v \
           serv/serv_rf_ram_if.v serv/serv_rf_top.v serv/serv_state.v \
           serv/serv_synth_wrapper.v serv/serv_top.v \
           zirh_tmr_ff32.v zirh_clk_rst.v zirh_rom.v zirh_bus.v \
           zirh_ecc_ram.v zirh_rs422.v zirh_uart_regs.v zirh_soc.v \
           zirh_hk.v zirh_tlm2.v zirh_env.v zirh_can.v zirh_spw.v \
           zirh_ifc.v zirh_tlm_mirror.v zirh_boot_ctrl.v \
           zirh_isp_rx.v tt_um_hma_zirh2.v

TOP_SRCS  := $(addprefix $(SRC_DIR)/,$(TOP_SOURCES))
BOOT_SRCS := $(SRC_DIR)/zirh_boot_ctrl.v $(SRC_DIR)/zirh_tmr_lib.v

BUILD := sim_build/svs

PLUSARGS :=
ifneq ($(SCENARIO),)
PLUSARGS += +SCENARIO=$(SCENARIO)
endif

.PHONY: all top boot clean
all: boot top

top: $(BUILD)/top.vvp
	vvp $(BUILD)/top.vvp $(PLUSARGS)

boot: $(BUILD)/boot.vvp
	vvp $(BUILD)/boot.vvp $(PLUSARGS)

$(BUILD)/top.vvp: sv/zirh_scenarios_tb.sv $(TOP_SRCS) $(SRC_DIR)/rom_init.vh
	mkdir -p $(BUILD)
	iverilog -g2012 -DZIRH_SIM_ENV -I$(SRC_DIR) \
	  -s zirh_scenarios_tb -o $@ sv/zirh_scenarios_tb.sv $(TOP_SRCS)

$(BUILD)/boot.vvp: sv/zirh_boot_scenarios_tb.sv $(BOOT_SRCS)
	mkdir -p $(BUILD)
	iverilog -g2012 -I$(SRC_DIR) \
	  -s zirh_boot_scenarios_tb -o $@ sv/zirh_boot_scenarios_tb.sv $(BOOT_SRCS)

clean:
	rm -rf $(BUILD)
