# =============================================================================
# ZIRH-2 - unit test for zirh_env (no TT harness, DUT driven directly)
#
#   make -C test -f Makefile.env
#
# ZIRH_SIM_ENV swaps the hand-instantiated SG13G2 oscillator and catch
# chain for behavioral models - a zero-delay combinational loop would
# hang event-driven simulation. What this suite verifies is the control
# path: windowing, capture, re-arm, counting, clear.
# =============================================================================

SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(PWD)/../src

SIM_BUILD = sim_build/env

VERILOG_SOURCES += $(SRC_DIR)/zirh_tmr_lib.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_env.v

TOPLEVEL = zirh_env
COCOTB_TEST_MODULES = test_env

COMPILE_ARGS += -DZIRH_SIM_ENV

include $(shell cocotb-config --makefiles)/Makefile.sim
