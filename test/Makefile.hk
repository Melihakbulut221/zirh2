# =============================================================================
# ZIRH-2 - unit test for zirh_hk (no TT harness, DUT driven directly)
#
#   make -C test -f Makefile.hk
#
# N is overridden to 16 so warm-up is 20 cycles. test_hk.py hardcodes it.
# =============================================================================

SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(PWD)/../src

SIM_BUILD = sim_build/hk

VERILOG_SOURCES += $(SRC_DIR)/zirh_tmr_lib.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_tmr_ff32.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_hk.v

TOPLEVEL = zirh_hk
COCOTB_TEST_MODULES = test_hk

N ?= 16
COMPILE_ARGS += -Pzirh_hk.N=$(N)
# Keep in sync with WD_LIMIT in test_hk.py
COMPILE_ARGS += -Pzirh_hk.WD_LIMIT_LOG2=10

include $(shell cocotb-config --makefiles)/Makefile.sim
